{
  "manifest_version": 3,
  "name": "Growth Hack GS AI",
  "version": "1.1.4",
  "description": "Reads the Settings tab of a Google Sheet (labels in Column A, links in Column B), scrapes Screener.in pages, and writes the data into a matching tab (created if missing).",
  "permissions": ["tabs", "activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://*.screener.in/*",
    "https://screener.in/*",
    "https://oauth2.googleapis.com/*",
    "https://*.googleapis.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup2.html",
    "default_title": "Growth Hack GS AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.screener.in/*",
        "https://screener.in/*",
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}